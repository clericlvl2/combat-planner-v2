# Image tag of a release: https://github.com/clericlvl2/combat-planner-v2/pkgs/container/combat-planner-v2
APP_IMAGE=ghcr.io/clericlvl2/combat-planner-v2:<tag>

# Bare domain whose A record points to this server, e.g. planner.example.com
DOMAIN=
BETTER_AUTH_URL=https://${DOMAIN}

# Each: the output of `openssl rand -hex 32`; keep a copy in the password manager
BETTER_AUTH_SECRET=
LINK_SECRET=

# Yandex Cloud console: Object Storage bucket name, and the static access key of the service account `litestream`
LITESTREAM_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
