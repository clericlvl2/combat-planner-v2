# Optional settings for `pnpm dev` and `docker compose up`, read from `.env` at the repository
# root when it exists. The server refuses to start on a wrong value and names the variable;
# under Docker it is readable with `docker compose logs app`. The image runs with
# NODE_ENV=production.
#
# Data under Docker: the database is /data/combat-planner.db and the secrets /data/secrets.json,
# in the `data` volume; without Docker, in apps/server/data/. The server refuses to start on an
# unreadable or broken secrets.json and names its path and the server uid instead of generating
# new secrets. A host directory bind-mounted at /data must be writable by uid 1000, or the service
# sets `user: "${UID}:${GID}"` with UID and GID below.
#
# Health check: GET /api/health answers {"status":"ok"}.

# Published host port under Docker; the container listens on 3000.
PORT=3000

# Public URL of the app, set for https or a reverse proxy. When set, the server accepts requests
# only from this origin and BETTER_AUTH_TRUSTED_ORIGINS; when empty, from the origin each request
# was sent to.
BETTER_AUTH_URL=
# Comma-separated extra origins accepted next to BETTER_AUTH_URL.
BETTER_AUTH_TRUSTED_ORIGINS=

# Take precedence over the generated values in secrets.json. Each at least 32 characters, e.g.
# the output of `openssl rand -hex 32`.
# BETTER_AUTH_SECRET=
# LINK_SECRET=

# Google and GitHub sign-in: both values of a pair or neither; with only one the server refuses
# to start and names the missing one. An empty pair keeps that sign-in off. Callback URLs to
# register: <public URL>/api/auth/callback/google and <public URL>/api/auth/callback/github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# About page source link. A Docker build argument baked into the web bundle: a change takes
# effect with the next `docker compose up --build`. An empty value keeps the default link.
VITE_SOURCE_URL=https://github.com/clericlvl2/combat-planner-v2

# 1 turns on the status page /admin and GET /api/health/checks; any other value answers 404 there.
# /admin has no login of its own: expose it only behind one, as deploy/Caddyfile does.
ADMIN_PAGE=
# Version shown on /admin; empty shows `dev`. The release image sets it to its version.
APP_VERSION=

# Output of `id -u` and `id -g`, for `user: "${UID}:${GID}"` on a bind-mounted /data.
# UID=
# GID=
