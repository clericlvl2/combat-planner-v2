{
  "projectId": "fbddc215-2bc6-42e0-be0e-28a257546a95",
  "pkg": "@combat-planner/ui",
  "shape": "storybook",
  "storybookConfigDir": "packages/ui/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "node .design-sync/build-ui.mjs",
  "entry": "dist/index.js",
  "cssEntry": "dist/design-sync.css",
  "extraFonts": [
    "node_modules/@fontsource/unbounded/600.css",
    "node_modules/@fontsource/unbounded/700.css",
    "node_modules/@fontsource/rubik/400.css",
    "node_modules/@fontsource/rubik/500.css",
    "node_modules/@fontsource/rubik/600.css",
    "node_modules/@fontsource/rubik/700.css",
    "node_modules/@fontsource/noto-sans-jp/400.css",
    "node_modules/@fontsource/noto-sans-jp/500.css",
    "node_modules/@fontsource/noto-sans-jp/700.css"
  ],
  "libOverrides": {
    "source-storybook.mjs": ".storybook/preview imports @fontsource CSS (font files need an empty loader; fonts ship through extraFonts), and its decorators import DS modules such as src/provider.tsx by relative path, which must resolve to the shipped bundle so contexts match and Vite-only import.meta.glob never bundles; preview loaders (apiLoader) run synchronously into ctx.loaded for the global decorators; cfg.extraEntries resolve to the DS global in the decorator bundle",
    "story-imports.mjs": "stories use CSF factories (preview.meta / meta.story from definePreview in @storybook/react-vite) and export no default meta; the stub merges meta into each story object and runs the preview decorators per story with real globals, parameters and loaded; storybook-addon-remix-react-router becomes a memory router on the DS react-router"
  },
  "storyImports": {
    "shim": [
      "packages/ui/src/provider.tsx",
      "packages/ui/src/api/",
      "packages/ui/src/layout.ts",
      "packages/ui/src/theme.ts"
    ]
  },
  "extraEntries": ["react-router", "@tanstack/react-query", "react-i18next"],
  "overrides": {
