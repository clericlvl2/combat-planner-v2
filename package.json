{
  "name": "combat-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check && tsc -b && node scripts/check-stories.mjs && node scripts/check-i18n.mjs && node scripts/check-comments.mjs",
    "test": "vp test --project unit --project storybook",
    "storybook": "storybook dev -c packages/ui/.storybook -p 6006 --no-open",
    "storybook:build": "storybook build -c packages/ui/.storybook -o packages/ui/storybook-static --quiet",
    "build": "pnpm --filter @combat-planner/web run build",
    "dev": "pnpm --parallel --filter @combat-planner/web --filter @combat-planner/server run dev",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "i18next": "^26.4.7",
    "playwright": "1.64.1",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "10.6.2",
    "storybook-addon-remix-react-router": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.34.7"
}
